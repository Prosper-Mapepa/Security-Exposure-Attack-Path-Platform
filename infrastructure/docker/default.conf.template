server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  client_max_body_size 6m;

  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_connect_timeout 3s;
    proxy_send_timeout 20s;
    proxy_read_timeout 20s;
    proxy_next_upstream error timeout http_502 http_503 http_504;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    error_page 502 503 504 = @api_down;
  }

  location /health {
    proxy_pass ${API_UPSTREAM}/health;
    proxy_connect_timeout 3s;
    proxy_read_timeout 5s;
    proxy_set_header Host $proxy_host;
    error_page 502 503 504 = @api_down;
  }

  location /ready {
    proxy_pass ${API_UPSTREAM}/ready;
    proxy_connect_timeout 3s;
    proxy_read_timeout 5s;
    proxy_set_header Host $proxy_host;
    error_page 502 503 504 = @api_down;
  }

  location /ws/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_connect_timeout 3s;
    proxy_read_timeout 3600s;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $proxy_host;
  }

  location @api_down {
    default_type application/json;
    return 502 '{"error":{"message":"API is unreachable. On Railway: api service Online, named api, PORT=8080; web API_UPSTREAM=http://api.railway.internal:8080. Redeploy api then web."}}';
  }

  location / {
    try_files $uri /index.html;
  }
}
