server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  client_max_body_size 6m;

  # Variable proxy_pass forces per-request DNS (Railway private IPs change across deploys).
  resolver ${DNS_RESOLVER} valid=10s ipv6=on;

  location /api/ {
    set $seap_api "${API_UPSTREAM}";
    proxy_pass $seap_api;
    proxy_http_version 1.1;
    proxy_connect_timeout 3s;
    proxy_send_timeout 20s;
    proxy_read_timeout 20s;
    proxy_next_upstream error timeout http_502 http_503 http_504;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    error_page 502 503 504 = @api_down;
  }

  location /health {
    set $seap_api "${API_UPSTREAM}";
    proxy_pass $seap_api/health;
    proxy_connect_timeout 3s;
    proxy_read_timeout 5s;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    error_page 502 503 504 = @api_down;
  }

  location /ready {
    set $seap_api "${API_UPSTREAM}";
    proxy_pass $seap_api/ready;
    proxy_connect_timeout 3s;
    proxy_read_timeout 5s;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    error_page 502 503 504 = @api_down;
  }

  location /ws/ {
    set $seap_api "${API_UPSTREAM}";
    proxy_pass $seap_api;
    proxy_http_version 1.1;
    proxy_connect_timeout 3s;
    proxy_read_timeout 3600s;
    proxy_ssl_server_name on;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $proxy_host;
  }

  location @api_down {
    default_type application/json;
    return 502 '{"error":{"message":"API is unreachable. On the api service add PORT=8080, redeploy api, then redeploy web. web API_UPSTREAM must stay http://api.railway.internal:8080."}}';
  }

  location / {
    try_files $uri /index.html;
  }
}
